# exceção: cópias jogáveis guardadas pelo Git LFS (ver .gitattributes)
!Builds_Jogaveis/*.apk

# EXTRACT: STARDUST — RED DUST DIVIDE: geometria gerada pelo pipeline do Blender
# (regenerar com: powershell -File ExtractStardustRDD/Tools/m1_pipeline.ps1)
ExtractStardustRDD/Art/Export/
ExtractStardustRDD/Assets/RedDust/Generated/
ExtractStardustRDD/Assets/RedDust/Generated.meta

# Jogo anterior (ilha): saída intermédia do gerador de mundo (o resultado importado está em Assets/World)
ExtractStardust/WorldGen/out/
ExtractStardust/WorldGen/**/__pycache__/

# Blender: cópias de segurança automáticas
*.blend1
*.blend2

# Sistema
Thumbs.db
Desktop.ini
.DS_Store

# Python: caches
**/__pycache__/

# Unreal Engine: pastas geradas pelo editor e pelas compilações
ExtractStardustUE/Binaries/
ExtractStardustUE/DerivedDataCache/
ExtractStardustUE/Intermediate/
ExtractStardustUE/Saved/
ExtractStardustUE/*.sln
ExtractStardustUE/*.slnx

# IDE: solucao do Unity 6000.6 (artefacto de IDE, nao entra)
**/*.slnx

# Cena do laboratorio: 115 MB, excede o limite de 100 MB por ficheiro do GitHub.
# Regenerar com: Red Dust / 9. Gerar Metrics Lab (V2), ou MetricsLabBuilder.Build em batchmode.
ExtractStardustRDD/Assets/RedDust/Scenes/RDD_MetricsLab.unity
ExtractStardustRDD/Assets/RedDust/Scenes/RDD_MetricsLab.unity.meta

# Workflows do GitHub: publicar exige o scope 'workflow' no token, que nao temos.
# Fica em Docs/ci.yml.referencia; para ativar, copiar para .github/workflows/ e usar um token com scope.
.github/workflows/
